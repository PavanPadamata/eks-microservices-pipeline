# Copy to .env and fill in. Never commit .env.
# Only placeholders belong in this file.

# --- Service configuration (used by docker run / local dev) ---
WORKER_URL=http://worker:8000
WORKER_TIMEOUT_S=2
WORK_MS=20

# --- Local Jenkins (make jenkins-up) ---
JENKINS_ADMIN_PASSWORD=

# --- AWS / EKS (only needed for the EKS path) ---
AWS_REGION=eu-central-1
AWS_PROFILE=default
# ECR registry host, e.g. <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=
